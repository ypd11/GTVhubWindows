<Window x:Class="GTVApps.IncompatibleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTV hub - System Incompatible" 
        Width="500" 
        SizeToContent="Height" 
        WindowStartupLocation="CenterScreen" 
        Background="#121212" 
        ResizeMode="NoResize"
        MinWidth="500">

    <Window.Resources>
        <Style x:Key="GTVButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2482DB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2482DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="40,40,40,60">
            <TextBlock Text="✕" Foreground="#FF4B4B" FontSize="60" 
                       HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Unsupported Windows Version" 
                       Foreground="White" FontSize="22" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="GTV hub requires Windows 10 or Windows 11. Your current version of Windows does not support the modern WebView2 engine needed for this app." 
                       Foreground="#AAAAAA" TextWrapping="Wrap" TextAlignment="Center" 
                       FontSize="14" LineHeight="20" Margin="0,0,0,10"/>

            <Button Content="Exit Application" 
                    Style="{StaticResource GTVButtonStyle}"
                    Width="180" Height="45" 
                    Margin="0,30,0,0"
                    Cursor="Hand"
                    Click="ExitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>