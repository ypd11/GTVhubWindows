<Window x:Class="GTVApps.MissingRuntimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTV hub - Runtime Missing" 
        Width="500" SizeToContent="Height" 
        WindowStartupLocation="CenterScreen" 
        Background="#121212" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="GTVButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2482DB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2482DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="40,40,40,60">
            <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                <Ellipse Width="60" Height="60" Stroke="#FFA500" StrokeThickness="3"/>
                <TextBlock Text="!" Foreground="#FFA500" FontSize="40" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
            </Grid>

            <TextBlock Text="WebView2 Runtime Missing" Foreground="White" 
                       FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="GTV hub requires the Microsoft Edge WebView2 Runtime to display content. Please download and install it to continue." 
                       Foreground="#AAAAAA" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,0,0,25"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Download Now" Style="{StaticResource GTVButtonStyle}" 
                        Width="150" Height="45" Margin="0,0,10,0" Click="Download_Click" Cursor="Hand"/>
                <Button Content="Exit" Style="{StaticResource GTVButtonStyle}" 
                        Width="100" Height="45" Click="Exit_Click" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>