<Window x:Class="GTVApps.NoInternetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTV hub - No Connection" 
        Width="450" SizeToContent="Height" 
        WindowStartupLocation="CenterScreen" 
        Background="#121212" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="GTVButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2482DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="40,40,40,60">
            <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                <Ellipse Width="60" Height="60" Stroke="#FF4B4B" StrokeThickness="3"/>
                <TextBlock Text="🌐" Foreground="#FF4B4B" FontSize="30" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
            </Grid>

            <TextBlock Text="No Internet Connection" Foreground="White" 
                       FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="GTV hub requires an active internet connection to stream movies and TV shows. Please check your router or WiFi settings." 
                       Foreground="#AAAAAA" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,0,0,25"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Try Again" Style="{StaticResource GTVButtonStyle}" 
                        Width="120" Height="40" Margin="0,0,10,0" Click="Retry_Click"/>
                <Button Content="Exit" Style="{StaticResource GTVButtonStyle}" 
                        Width="100" Height="40" Click="Exit_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>