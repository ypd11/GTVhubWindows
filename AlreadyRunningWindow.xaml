<Window x:Class="GTVApps.AlreadyRunningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTV hub - Already Running" 
        Width="450" SizeToContent="Height" 
        WindowStartupLocation="CenterScreen" 
        Background="#121212" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="GTVButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2482DB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2482DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="40,40,40,60">

            <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                <Ellipse Width="60" Height="60" 
                         Stroke="#2482DB" StrokeThickness="3"/>
                <TextBlock Text="i" Foreground="#2482DB" 
                           FontSize="38" FontWeight="Bold" 
                           FontFamily="Georgia"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Margin="0,-4,0,0"/>
            </Grid>

            <TextBlock Text="App Already Running" Foreground="White" 
                       FontSize="22" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="An instance of GTV hub is already open. Please check your taskbar or system tray." 
                       Foreground="#AAAAAA" TextWrapping="Wrap" 
                       TextAlignment="Center" FontSize="14" Margin="0,0,0,20"/>

            <Button Content="Got it" 
                    Style="{StaticResource GTVButtonStyle}" 
                    Width="150" Height="40" 
                    Click="Close_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>